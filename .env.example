POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gmf_annotation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

OPENAI_API_KEY=
# possible models: gpt-4o-mini, gpt-4.1-mini
OPENAI_MODEL=gpt-4o-mini
OPENAI_PROMPT_VERSION=v1
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_COMPLETION_TOKENS=
OPENAI_TIMEOUT_SECONDS=30

GOOGLE_API_KEY=
# possible models: gemini-2.0-flash, gemini-2.5-flash-preview-04-17
GOOGLE_MODEL=gemini-2.0-flash
GOOGLE_PROMPT_VERSION=v1
GOOGLE_TEMPERATURE=0.0
GOOGLE_MAX_OUTPUT_TOKENS=
GOOGLE_TIMEOUT_SECONDS=30

HF_TOKEN=
# possible models: meta-llama/Llama-3.3-70B-Instruct, Qwen/Qwen2.5-72B-Instruct, deepseek-ai/DeepSeek-V3,
#                  mistralai/Mixtral-8x7B-Instruct-v0.1, meta-llama/Llama-3.1-8B-Instruct, Qwen/Qwen2.5-7B-Instruct
HF_MODEL=Qwen/Qwen3-32B
HF_PROVIDER=auto
HF_PROMPT_VERSION=v1
HF_TEMPERATURE=0.0
HF_MAX_TOKENS=
HF_TIMEOUT_SECONDS=60

API_BASE_URL=http://localhost:8000
